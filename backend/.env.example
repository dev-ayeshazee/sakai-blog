# --- Server ---
NODE_ENV=development
PORT=3001
CORS_ORIGIN=http://localhost:4200

# --- Database ---
# Local Docker Postgres (see ../docker-compose.yml). Host port 5544.
DATABASE_URL=postgres://blog:blog@localhost:5544/blog
DATABASE_SSL=false
#
# To use Supabase instead, take "Connection string" > "URI" from
# Project Settings > Database and set:
# DATABASE_URL=postgres://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres
# DATABASE_SSL=true

# --- Auth ---
JWT_SECRET=dev-only-insecure-secret-change-me
JWT_EXPIRES_IN=7d

# --- AI middleware ---
# heuristic (default, fully offline) | anthropic
AI_PROVIDER=heuristic
# Model id for the HTTP provider; required only when AI_PROVIDER=anthropic.
AI_MODEL=
# ANTHROPIC_API_KEY=sk-ant-...

# --- MCP ---
# Leave unset to use the bundled in-process mock MCP server.
# MCP_SERVER_URL=http://localhost:3001/api/mcp

# --- Boot behaviour ---
RUN_MIGRATIONS=false
